# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# PayPal
VITE_PAYPAL_CLIENT_ID=your_paypal_client_id
VITE_PAYPAL_CURRENCY=EUR

# Cloudflare R2 (public read URL for images)
VITE_R2_PUBLIC_URL=https://your-bucket.r2.dev

# App
VITE_APP_URL=http://localhost:5173
VITE_SITE_URL=https://fokusaward.com

# ----------------------------------------------------------------
# Supabase Edge Function secrets — set via:
#   supabase secrets set KEY=VALUE
# (these are NOT read by the Vite client — keep them server-side)
# ----------------------------------------------------------------

# PayPal server-side
PAYPAL_API_URL=https://api-m.paypal.com           # https://api-m.sandbox.paypal.com for sandbox
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=photoproject

# Email — Resend (https://resend.com)
RESEND_API_KEY=
FROM_EMAIL=FOKUS Award <noreply@fokusaward.com>
CONTACT_INBOX=info@fokusaward.com

# CORS allow-list for edge functions
ALLOWED_ORIGIN=https://fokusaward.com,https://www.fokusaward.com
SITE_URL=https://fokusaward.com

# Internal key for function-to-function calls (send-email template mode,
# process-email-queue worker). Generate a long random string:
#   openssl rand -hex 32
INTERNAL_API_KEY=
